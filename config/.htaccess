# ──────────────────────────────────────────────
#  Protección del directorio de configuración
#  Bloquea el acceso HTTP directo a los archivos de configuración
# ──────────────────────────────────────────────

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
